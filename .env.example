# Використання ШІ: файл створено за допомогою Claude (Anthropic) на основі os.getenv у src/ та docker-compose.yml.
# Перевірено звіркою назв і значень за замовчуванням з кодом; API стартував локально з копією цього файлу і згенерованим JWT_SECRET.
# Рядок про обов'язкові змінні уточнено за допомогою Claude Code (01.11.2026) і звірено з validate_auth_settings у src/api/tokens.py.
# Скопіюйте в .env (він в .gitignore). Обов'язкова: JWT_SECRET. MS_TENANT_ID і MS_CLIENT_ID потрібні для входу через Microsoft і при APP_ENV=production. Решта має типові значення.
# Змінні для frontend: frontend/.env.example.

# База даних. Порожньо: локальний SQLite-файл yourpath.sqlite (при APP_ENV=production DATABASE_URL обов'язковий).
# PostgreSQL: docker compose up -d db, далі розкоментуйте рядок нижче.
# DATABASE_URL=postgresql://yourpath:yourpath@localhost:5432/yourpath

# Демо-дані при старті разом із міграціями Alembic (1 = так, 0 = ні). Без змінної: так, окрім APP_ENV=production.
SEED_DEMO_DATA=1

# Адреса і журнал API (порт 3000 задано в коді).
API_HOST=127.0.0.1
LOG_LEVEL=INFO

# CORS: явний список origin через кому. "*" заборонено: API не стартує (cookie-автентифікація).
CORS_ORIGINS=http://localhost:5173

# Дозволені redirect URI для входу через SSO, через кому. Порожньо: лише базова перевірка URL.
ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/callback

# Microsoft Entra ID (app registration у tenant НаУКМА). Tenant — GUID, не "common".
MS_TENANT_ID=
MS_CLIENT_ID=
# Лише для типу застосунку Web. Для SPA (PKCE без секрету) залишити порожнім.
MS_CLIENT_SECRET=

# Секрет підпису access-токенів, мінімум 32 символи.
# Згенерувати: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Дозволені домени пошти через кому і адміністратори (отримують роль admin при першому вході).
ALLOWED_EMAIL_DOMAINS=ukma.edu.ua
ADMIN_EMAILS=

# Refresh-cookie. COOKIE_SECURE=0 лише для http://localhost (Safari); у production заборонено.
COOKIE_SECURE=1
COOKIE_SAMESITE=strict

# Значення, які API повертає у /config.
# client_id береться з MS_CLIENT_ID вище.
# REVIEWS_URL=https://example.ukma.edu.ua/reviews

# development | production.
APP_ENV=development

# Використання ШІ: Codex уточнив конфігурацію Microsoft і MCP; перевірка: звірено з кодом та pytest.
# Обов’язковий чинний токен для mcp/mcp_server.py (права власника, строк дії 15 хв): видати через python -m scripts.issue_token email@ukma.edu.ua
# MCP_API_TOKEN=
