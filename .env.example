# Використання ШІ: файл створено за допомогою Claude (Anthropic) на основі os.getenv у src/ та docker-compose.yml.
# Перевірено звіркою назв і значень за замовчуванням з кодом; сам застосунок із цим файлом не запускався.
# Скопіюйте в .env (він в .gitignore). Усі змінні необов'язкові: значення нижче збігаються з типовими.
# Змінні для frontend: frontend/.env.example.

# База даних. Порожньо: локальний SQLite-файл yourpath.sqlite.
# PostgreSQL: docker compose up -d db, далі розкоментуйте рядок нижче.
# DATABASE_URL=postgresql://yourpath:yourpath@localhost:5432/yourpath

# Демо-дані при старті разом із міграціями Alembic (1 = так, 0 = ні).
SEED_DEMO_DATA=1

# Адреса і журнал API (порт 3000 задано в коді).
API_HOST=127.0.0.1
LOG_LEVEL=INFO

# CORS: список origin через кому. "*" дозволяє всі (лише для розробки).
CORS_ORIGINS=*

# Дозволені redirect URI для входу через SSO, через кому. Порожньо: перевірка вимкнена.
ALLOWED_REDIRECT_URIS=

# Значення, які API повертає у /config. Назва GOOGLE_CLIENT_ID історична, у полі client_id для Microsoft.
# GOOGLE_CLIENT_ID=
# REVIEWS_URL=https://example.ukma.edu.ua/reviews

# development | production. У production MCP_DEV_MODE=1 заборонено.
APP_ENV=development
# MCP_DEV_MODE=1   # лише для mcp/mcp_server.py: виклики без заголовка Authorization
