# Використання ШІ: файл створено за допомогою Claude (Anthropic).
# Скопіюйте в .env.local. За замовчуванням UI працює з реальним бекендом (uvicorn на :3000), без моків.
# Для входу потрібні VITE_MS_CLIENT_ID і VITE_MS_TENANT (GUID tenant) тієї ж app registration, що й MS_* у корені.
VITE_USE_MOCKS=false
VITE_API_BASE=/api/v1
VITE_MS_CLIENT_ID=
VITE_MS_TENANT=
# true: моки входу, профілю, побажань, деканату й адмінки (інше з бекенду). full: моки всього, бекенд не потрібен.
# VITE_USE_MOCKS=full
# admin: мок-користувач стає адміністратором (екрани /admin).
# VITE_MOCK_ROLE=admin
